# ContigoCare Admin — environment template
#
# Copy to .env.development (or .env.production) and fill in.
# Two secrets have no safe default and the app refuses to start without them:
# JWT_SECRET_KEY and ENCRYPTION_KEY. Generate both with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                      # JWT_SECRET_KEY
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # ENCRYPTION_KEY

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
PROJECT_NAME="ContigoCare Admin"
VERSION=2.0.0
DEBUG=true
API_V1_STR=/api/v1

# Named origins only. `*` is rejected in production: the refresh cookie requires
# credentialed requests, and the CORS spec forbids pairing those with a wildcard.
ALLOWED_ORIGINS="http://localhost:5173"

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
# The 2.0 generation this tool was specified against has been retired and 404s.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=8192
# Three nested budgets: attempt < call < request. A saturated model stalls
# before the response headers rather than answering slowly, so a short attempt
# cap reaches the fallback model faster than a long one waits.
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2
# The ceiling on one model call: every attempt, every backoff and the fallback
# model together. Without it those caps multiply out into minutes.
GEMINI_CALL_BUDGET_SECONDS=90

# The agent re-reads its own draft and repairs fields whose evidence could not
# be found in the document. Roughly doubles cost on documents that need it.
ANALYSIS_SELF_CRITIQUE_ENABLED=true
ANALYSIS_PROMPT_VERSION=v1
# The ceiling on one POST /analyze — extraction plus a repair pass. The
# frontend's own budget for that route must sit above this, or the browser
# gives up first and the operator gets a blank timeout instead of the reason.
ANALYSIS_TIMEOUT_SECONDS=195

# ---------------------------------------------------------------------------
# Document intake — nothing here is written to disk
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=15728640
MAX_PDF_PAGES=60
MAX_EXTRACTED_CHARS=400000
# Refuse to call the model when the admin-approved text still contains
# high-confidence identifiers. Turn this off only with a very good reason.
REDACTION_ENFORCE_ON_SUBMIT=true

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET_KEY="CHANGE_ME_generate_with_secrets_token_urlsafe_48"
JWT_ALGORITHM=HS256
JWT_ISSUER=contigocare-admin-api
JWT_AUDIENCE=contigocare-admin-console
# The access token lives in browser memory, so its lifetime is the XSS window.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
MFA_CHALLENGE_EXPIRE_MINUTES=5

# Encrypts TOTP seeds at rest. In production this belongs in a secrets manager,
# injected at boot — not in a file next to the database it protects.
ENCRYPTION_KEY="CHANGE_ME_generate_with_Fernet_generate_key"

# Cookies. COOKIE_SECURE must be true in production (enforced at startup);
# development defaults it to false because localhost has no TLS.
REFRESH_COOKIE_NAME=cc_rt
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
CSRF_COOKIE_NAME=cc_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# Google Authenticator
TOTP_ISSUER="ContigoCare Admin"
TOTP_DIGITS=6
TOTP_PERIOD_SECONDS=30
TOTP_VALID_WINDOW=1
RECOVERY_CODE_COUNT=10

MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Password reset by email
# ---------------------------------------------------------------------------
# Redeeming a reset link changes the password and nothing else — no session, no
# access token. The operator still signs in with Google Authenticator, so
# control of a mailbox never adds up to control of an account.

# Where the emailed link points. Must be the console's own origin, and https://
# in production (enforced at startup) — the link carries a single-use token.
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_PATH=/reset-password
# Minutes. The link sits in an inbox; every extra minute is time it can be read
# by whoever gets into that inbox next.
PASSWORD_RESET_EXPIRE_MINUTES=30

# SMTP. With SMTP_HOST empty, mail is written to the log instead of sent — which
# is how the flow is walked through on a laptop. Production refuses to start in
# that state, because a reset link nobody receives is a reset that silently
# does not work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 587 with STARTTLS is the default. For implicit TLS on 465, set SMTP_USE_TLS
# true and SMTP_USE_STARTTLS false.
SMTP_USE_STARTTLS=true
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=15
EMAIL_FROM=no-reply@contigo.care
EMAIL_FROM_NAME=ContigoCare
# Leave unset to follow SMTP_HOST. Set false to silence mail entirely.
# EMAIL_ENABLED=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=contigocare
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ---------------------------------------------------------------------------
# Optional: Valkey (rate-limit storage across instances)
# ---------------------------------------------------------------------------
# VALKEY_HOST=valkey
# VALKEY_PORT=6379
# VALKEY_PASSWORD=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST=https://cloud.langfuse.com

LOG_LEVEL=DEBUG
LOG_FORMAT=console

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_LOGIN="10 per minute"
RATE_LIMIT_MFA_VERIFY="10 per minute"
# Tight on purpose: /password/forgot sends mail to an address the caller chose.
RATE_LIMIT_PASSWORD_FORGOT="3 per minute"
RATE_LIMIT_PASSWORD_RESET="10 per minute"
RATE_LIMIT_EXTRACT="20 per minute"
RATE_LIMIT_ANALYZE="20 per minute"
